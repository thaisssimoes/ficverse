DATABASE_URL=postgres://postgres:postgres@localhost:5432/fanfic_platform?sslmode=disable
JWT_SECRET=your-secret-key-change-in-production
PORT=8080

# Executa AutoMigrate do GORM ao iniciar o servidor.
# Ative apenas na primeira execução ou ao adicionar novos campos/modelos.
# Manter false em produção para evitar lentidão no startup.
AUTO_MIGRATE=false

# Configurações de email para recuperação de senha
# Para Gmail: use uma "Senha de app" em https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app

# URL do frontend (onde ficam as páginas de reset de senha)
FRONTEND_URL=http://localhost:3000

# ─── Storage ────────────────────────────────────────────────────────────────
# Provider de armazenamento de imagens.
#   "local"    → salva em ./uploads/ (desenvolvimento; arquivos somem no redeploy)
#   "supabase" → Supabase Storage (recomendado)
STORAGE_PROVIDER=local

# Supabase Storage (preencha apenas quando STORAGE_PROVIDER=supabase)
# SUPABASE_URL é a URL do seu projeto: https://xxxx.supabase.co
# SUPABASE_KEY é a "service_role" key (Settings → API → service_role)
# SUPABASE_BUCKET é o nome do bucket criado no Supabase Storage (deve ser público)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your-service-role-key
SUPABASE_BUCKET=lollipopfics
