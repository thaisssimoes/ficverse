DATABASE_URL=postgres://postgres:postgres@localhost:5432/fanfic_platform?sslmode=disable
JWT_SECRET=your-secret-key-change-in-production
PORT=8080

# Configurações de email para recuperação de senha
# Para Gmail: use uma "Senha de app" em https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app

# URL do frontend (onde ficam as páginas de reset de senha)
FRONTEND_URL=http://localhost:3000
